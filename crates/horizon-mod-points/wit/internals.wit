// One interface for the declared internals, independent of the game's table.
package horizon:mod-internals@0.1.0;

interface view {
  /// A value in pre-order; compound cells give their number of immediate children.
  variant cell { none, b(bool), c(char), s(s64), u(u64), f(f64), str(string), seq(u32), rec(u32), var(tuple<u32, u32>) }
  variant refusal { gone(string), changed(string), not-here(string) }

  /// A path from one of the current raw call's roots. It expires with that call.
  resource node {
    field: func(n: u32) -> result<node, refusal>;
    get: func(n: u32) -> result<list<cell>, refusal>;
    set: func(n: u32, v: list<cell>) -> result<_, refusal>;
    index: func(i: u64) -> result<reached, refusal>;
    key: func(k: list<cell>) -> result<reached, refusal>;
    len: func() -> result<u64, refusal>;
    case: func() -> result<u32, refusal>;
    read: func() -> result<list<cell>, refusal>;
  }
  variant reached { node(node), value(list<cell>) }
  variant arg { value(list<cell>), node(borrow<node>) }
  /// At most twelve entries; larger batches trap. Results keep node.get semantics.
  get-many: func(reads: list<tuple<borrow<node>, u32>>) -> list<result<list<cell>, refusal>>;
  /// At most twelve journaled writes; larger batches trap. Refusals are per entry.
  set-many: func(writes: list<tuple<borrow<node>, u32, list<cell>>>) -> list<result<_, refusal>>;
  root: func(n: u32) -> result<node, refusal>;
  /// Final mutable copy arguments are returned in parameter order, separate from node results.
  record call-reply { %result: reached, updates: list<list<cell>> }
  call: func(declared: u32, receiver: option<borrow<node>>, args: list<arg>) -> result<call-reply, refusal>;
}

interface raw-listeners {
  enum host-kind { read, server, client, none }
  /// Manifest internals and every named type walked by the generated view.
  declared: func() -> list<tuple<string, string>>;
  /// Point method name and the raw record's shape, in the guest's dispatch order.
  subscribed: func() -> list<tuple<string, string>>;
  fire: func(place: u32, host: host-kind);
}

world internals {
  import view;
  export raw-listeners;
}
